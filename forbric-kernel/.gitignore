# Local game instances. Keep probe source in canary/ (outside run/), and tools in run/compat/.
# .dev and run/client-* carry no trailing slash: a worktree links them to the main checkout's
# (link-fixtures.sh), and a pattern ending in / never matches a symlink.
/.dev
# Ignore whole instance trees so new game/mod output does not require another per-gate rule.
/run/client-*
/run/server-*/
/run/ac-client/
/run/ac-server/
/run/fab-client/
/run/fab-server/
/run/fnet-client/
/run/fnet-server/
/run/fhs-client/
/run/fhs-server/
/run/mp-client/
/run/mp-server/
/run/parity-*/
/run/savedrop/
/run/compat-world/
# installed, energy-api and .gate-downloads carry no trailing slash either: a worktree recreates them (a local dir, or a
# link/clone of the main checkout's), and 36dfef28 committed all three as symlinks into one worktree's own path because
# `/run/installed/` never matched a link.
/run/installed
# gate-m17 phase U's upgrade directory (C6), likewise without a trailing slash.
/run/installed-upgrade

# Generated probe jars and hash manifests; their sources live in /canary/.
/run/canary/
/run/energy-api
# carry-on and modmenu: no trailing slash, every worktree links them to the main checkout's (until 2026-11-02 only the
# machine-local .git/info/exclude ignored those links).
/run/carry-on
/run/modmenu
# The NeoForge builds that replaced the gates' MinecraftForge jars in Stage 3 of dropping MinecraftForge (lib.sh
# NEO_BUILDS). No trailing slash: a worktree links it to the main checkout's, and a pattern ending in / never matches
# a symlink.
/run/neoforge-builds
/run/.gate-downloads
# Stage 4 C5 paths, ignored before they exist so a link there is never committed: the frozen Forge->NeoForge swap fixture
# (linked from ~/Forbric-backups/forge-swap), gate-m58's world-upgrade rundir, and the rundirs of the new gates m58-m62
# (name them <what>-m58 ... <what>-m62 or m58-<what> ... so these patterns cover them).
/run/forge-swap
/run/world-upgrade
/run/*-m5[89]
/run/*-m6[0-2]
/run/m5[89]-*
/run/m6[0-2]-*
/run/.gate-clones/

# Gate bookkeeping and runtime output in any custom run/ instance directory.
.forbric-gate.pid
.forbric-java.args
.forbric-launch.json
/run/*/server.properties
/run/*/eula.txt
/run/*/usercache.json
/run/*/banned-*.json
/run/*/ops.json
/run/*/whitelist.json
/run/*/.mixin.out/
/run/*/logs/
/run/*/journeymap/
