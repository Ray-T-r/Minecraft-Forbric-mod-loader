# Local game instances. Keep probe source in canary/ (outside run/), and tools in run/compat/.
# .dev and run/client-* carry no trailing slash: a worktree links them to the main checkout's
# (link-fixtures.sh), and a pattern ending in / never matches a symlink.
/.dev
# Ignore whole instance trees so new game/mod output does not require another per-gate rule.
/run/client-*
/run/server-*/
/run/ac-client/
/run/ac-server/
/run/fab-client/
/run/fab-server/
/run/fnet-client/
/run/fnet-server/
/run/fhs-client/
/run/fhs-server/
/run/mp-client/
/run/mp-server/
/run/parity-*/
/run/savedrop/
/run/world-events-m49/
/run/compat-world/
/run/installed/

# Generated probe jars and hash manifests; their sources live in /canary/.
/run/canary/
/run/energy-api/
/run/carry-on/
/run/modmenu/
# The NeoForge builds that replaced the gates' MinecraftForge jars in Stage 3 of dropping MinecraftForge (lib.sh
# NEO_BUILDS). No trailing slash: a worktree links it to the main checkout's, and a pattern ending in / never matches
# a symlink.
/run/neoforge-builds
/run/.gate-downloads/
/run/.gate-clones/

# Gate bookkeeping and runtime output in any custom run/ instance directory.
.forbric-gate.pid
.forbric-java.args
.forbric-launch.json
/run/*/server.properties
/run/*/eula.txt
/run/*/usercache.json
/run/*/banned-*.json
/run/*/ops.json
/run/*/whitelist.json
/run/*/.mixin.out/
/run/*/logs/
/run/*/journeymap/
