# Local game instances. Keep probe source in canary/ (outside run/), and tools in run/compat/.
/.dev/
# Ignore whole instance trees so new game/mod output does not require another per-gate rule.
/run/client-*/
/run/server-*/
/run/ac-client/
/run/ac-server/
/run/fab-client/
/run/fab-server/
/run/fnet-client/
/run/fnet-server/
/run/fhs-client/
/run/fhs-server/
/run/mp-client/
/run/mp-server/
/run/parity-*/
/run/savedrop/
/run/world-events-m49/
/run/compat-world/
/run/installed/

# Generated probe jars and hash manifests; their sources live in /canary/.
/run/canary/
/run/energy-api/
/run/.gate-downloads/
/run/.gate-clones/

# Gate bookkeeping and runtime output in any custom run/ instance directory.
.forbric-gate.pid
/run/*/server.properties
/run/*/eula.txt
/run/*/usercache.json
/run/*/banned-*.json
/run/*/ops.json
/run/*/whitelist.json
/run/*/.mixin.out/
/run/*/logs/
/run/*/journeymap/
