{
  "schemaVersion": 1,
  "id": "pets-mod",
  "version": "0.8.4",
  "name": "Pets Mod",
  "accessWidener": "pets.accesswidener",
  "description": "Adds completely client-sided pets to your game. Supports every vanilla mob and will work on any server, including in singleplayer!",
  "authors": [
    "The Pets Team",
    "downloadableduck"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/pets-mod",
    "sources": "https://github.com/downloadableduck/petsmod",
    "issues": "https://github.com/downloadableduck/petsmod/issues"
  },
  "license": "MIT",
  "icon": "assets/pets-mod/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.jeff.pets.PetsInitializer"
    ],
    "client": [
      "com.jeff.pets.client.PetsClientInitializer",
      "com.jeff.pets.client.Central",
      "com.jeff.pets.client.network.PetsNetworked"
    ],
    "modmenu": [
      "com.jeff.pets.client.ModMenuEntry"
    ]
  },
  "mixins": [
    {
      "config": "pets.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": "\u003e\u003d0.18.4",
    "minecraft": "~26.2",
    "java": "\u003e\u003d25",
    "cloth-config": "*",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/pets-mod",
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/pets-mod"
      }
    }
  },
  "jars": [
    {
      "file": "META-INF/jars/Java-WebSocket-1.6.0.jar"
    },
    {
      "file": "META-INF/jars/ably-java-1.2.40.jar"
    },
    {
      "file": "META-INF/jars/msgpack-core-0.9.12.jar"
    },
    {
      "file": "META-INF/jars/vcdiff-core-0.1.1.jar"
    }
  ]
}