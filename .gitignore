# ---- Build output ----
build/
.gradle/
out/
bin/
*.class
.merged-base-tools/
.linkcheck-tools/

# ---- Binaries ----
# Game jars, mod jars, the merged base and the runtime carriers are all either
# downloaded or regenerated by run/build-merged-base.sh + run/assemble-*.sh.
# 1.7 GB of this tree is binaries; ~5.6 MB is source.
*.jar
# A pattern containing a slash is anchored to THIS file's directory, so the old
# `!gradle/wrapper/gradle-wrapper.jar` only ever un-ignored a root-level wrapper that
# does not exist here — every module's wrapper jar stayed ignored, and a fresh clone
# could not run ./gradlew anywhere. Match it at any depth instead.
!**/gradle/wrapper/gradle-wrapper.jar
*.zip
*.dylib
*.so
*.dll
*-natives/

# ---- Reference material — NOT part of this Apache-2.0 clean-room project ----
# FML/ holds 257 genuine LGPL net.minecraftforge.fml source files. Keeping it
# out of this repository's history is what preserves the clean-room provenance
# the whole project depends on.
/FML/
# fabric-loader/ is where bootstrap.sh clones the substrate: upstream's code at an upstream tag plus
# forbric-loader/patches/. Deliberately NOT vendored, so its provenance stays inspectable.
/fabric-loader/

# ---- Test-instance runtime state ----
logs/
saves/
world/
# ...but not a source package that happens to be called world. `world/` has no leading
# slash, so it matches at ANY depth, and it was swallowing forbric-loader's
# src/test/java/net/minecraft/world/** stand-ins — three files that were therefore never
# committed, so a fresh clone failed `./gradlew build` on missing net.minecraft.world
# classes. Same shape as the `config/` exception below.
!*/src/**/world/
world_nether/
world_the_end/
crash-reports/
crash/
resourcepacks/
defaultconfigs/
quickPlay/
downloads/
.forbric-kernel/
.fabric/
.cache/
.physics_mod_cache/
*.log
*.log.gz
config/
# ...but not a source package that happens to be called config (test stand-ins for FML's config classes).
!*/src/**/config/
debug/
usercache.json
usernamecache.json
options.txt
command_history.txt
realms_persistence.json
servers.dat*
session.lock
xaero/
XaeroWaypoints_BACKUP*/

# ---- macOS ----
.DS_Store

# ---- Claude ----
CLAUDE.md

# ---- Gradle's own download scratch ----
# Two empty .lck/.part files from an interrupted wrapper download, tracked here for months.
.gradle-local/
