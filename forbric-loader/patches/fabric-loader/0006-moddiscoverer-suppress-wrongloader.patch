+		for (Path path : candidate.getPaths()) {
+			String name = path.getFileName() == null ? "" : path.getFileName().toString();
+
+			for (String s : csv.split(",")) {
+				String want = s.trim();
+				if (!want.isEmpty() && name.equals(want)) return true;
+			}
+		}
+
+		return false;
+	}
