+	// original jar in mods/ carries a Fabric identity with loader-wrong mixins that must not be discovered.
+	private static boolean isSuppressedBySource(ModCandidateImpl candidate) {
+		String csv = System.getProperty("forbric.suppressModSources", "");
+		if (csv.isEmpty()) return false;
