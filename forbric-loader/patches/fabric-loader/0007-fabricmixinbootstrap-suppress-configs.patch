+	/**
+	 * Forbric: mixin configs listed in {@code -Dforbric.suppressMixinConfigs} (comma-separated names) are not
+	 * registered. Used on the traditional-MinecraftForge game base, where the registry lifecycle (freeze
+	 * windows, id tracking, sync, persistence) is owned by Forge's GameData: Fabric mixin configs that manage
+	 * the same lifecycle for the vanilla base are redundant there, and their injection anchors do not survive
+	 * Forge's binary patches (e.g. Bootstrap.bootStrap no longer calls wrapStreams).
+	 */
+	private static boolean isForbricSuppressedConfig(String config) {
+		String csv = System.getProperty("forbric.suppressMixinConfigs");
+		if (csv == null || csv.isEmpty()) return false;
+
+		for (String entry : csv.split(",")) {
+			if (config.equals(entry.trim())) return true;
+		}
+
+		return false;
+	}
+
+	/** Forbric: {@code -Dforbric.relaxMixinOverwrites} glob match (trailing {@code *} = prefix), see {@link MixinServiceKnot}. */
+	private static boolean isForbricRelaxedConfig(String config) {
+		String csv = System.getProperty("forbric.relaxMixinOverwrites");
+		if (csv == null || csv.isEmpty() || config == null) return false;
+
+		for (String raw : csv.split(",")) {
+			String entry = raw.trim();
+			if (entry.isEmpty()) continue;
+
+			if (entry.endsWith("*")) {
+				if (config.startsWith(entry.substring(0, entry.length() - 1))) return true;
+			} else if (config.equals(entry)) {
+				return true;
+			}
+		}
+
+		return false;
+	}
